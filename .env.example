# Copy to .env.local (Next.js) and fill in locally. Never commit real values.

# --- Public (browser-safe; sent to the client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Direct Postgres URL for the FastAPI/SQLAlchemy backend (contains the DB password).
# Backend-only. Use the Supabase pooler connection string.
DATABASE_URL=

# Code judge: disabled (default, safe) | mock (fake labelled results for dev/tests).
# No real sandbox provider is configured; never set anything else.
JUDGE_PROVIDER=disabled

# How AI evaluation runs after a report is submitted: background (default, local/long-lived server) |
# inline (inside the request; use on serverless hosts) | manual (admin presses "Run pending").
EVALUATION_MODE=background

# --- production / operations (all optional; see docs/DEPLOYMENT.md) ---
APP_ENV=development                 # set to 'production' on hosted services (fail-fast config, no /docs, HSTS)
DB_POOL_SIZE=6                      # connections per process; API + worker must fit Supabase's Session-pooler pool size
DB_MAX_OVERFLOW=2
AUTH_CACHE_SECONDS=30               # how long a validated token/role is trusted (0 = validate every request)
WORKER_INTERVAL_SECONDS=10          # evaluation worker poll interval
# Judge0 (only after docs/SANDBOX.md is completed): JUDGE_PROVIDER=judge0, JUDGE0_URL=, JUDGE0_TOKEN=, JUDGE0_LANGUAGE_IDS={}
# Next.js build: API_ORIGIN=https://<backend host>   (target of the /api rewrite)
